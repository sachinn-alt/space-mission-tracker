generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mission {
  id           Int      @id @default(autoincrement())
  missionName  String
  rocket       String
  destination  String
  launchDate   DateTime
  status       String
  createdAt    DateTime @default(now())
}